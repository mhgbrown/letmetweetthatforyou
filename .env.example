# Twitter/X API v2 Credentials
# Ensure your App in the Twitter Developer Portal has "Read and Write and Direct Messages" permission enabled.
# For local testing, copy this file to .env.development and fill in your keys.
# For production, set these as Repository Secrets in your GitHub Repo.

TWITTER_CONSUMER_KEY=your_consumer_key_here
TWITTER_CONSUMER_SECRET=your_consumer_secret_here
TWITTER_ACCESS_TOKEN_KEY=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here
